  email {$ACME_EMAIL}
}

{$WEB_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }
  reverse_proxy web:80
}

{$API_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }
  reverse_proxy api:4000
}
