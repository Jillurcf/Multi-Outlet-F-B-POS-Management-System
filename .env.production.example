NODE_ENV=production
POSTGRES_USER=pos
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=pos_db
DATABASE_URL="postgresql://pos:replace-with-a-strong-random-password@postgres:5432/pos_db?schema=public"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://pos.example.com
WEB_DOMAIN=pos.example.com
API_DOMAIN=api.pos.example.com
ACME_EMAIL=admin@example.com
VITE_API_URL=https://api.pos.example.com/api
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_NAME=HQ Admin
SEED_STAFF_PASSWORD=replace-with-a-strong-staff-password
