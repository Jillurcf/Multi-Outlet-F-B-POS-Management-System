{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../../scripts/run-bin.mjs tsx dist/cli.mjs watch src/server.ts",
    "build": "node ../../scripts/run-bin.mjs typescript bin/tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "node ../../scripts/run-bin.mjs typescript bin/tsc --noEmit -p tsconfig.json && node ../../scripts/run-bin.mjs typescript bin/tsc --noEmit -p tsconfig.test.json",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "prisma:generate": "node ../../scripts/run-bin.mjs prisma build/index.js generate",
    "prisma:migrate": "node ../../scripts/run-bin.mjs prisma build/index.js migrate dev",
    "prisma:migrate:deploy": "node ../../scripts/run-bin.mjs prisma build/index.js migrate deploy",
    "prisma:seed": "node ../../scripts/run-bin.mjs prisma build/index.js db seed",
    "prisma:studio": "node ../../scripts/run-bin.mjs prisma build/index.js studio"
  },
  "dependencies": {
    "@pos/shared": "*",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.16.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.15.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "node ../../scripts/run-bin.mjs tsx dist/cli.mjs prisma/seed.ts"
  }
}
